{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "nocturne",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "json",
          "path": "ui/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "phone/src-tauri/gen/apple/project.yml"
        },
        {
          "type": "xml",
          "path": "phone/src-tauri/gen/apple/nocturne-phone_iOS/Info.plist",
          "xpath": "//dict/key[text()='CFBundleShortVersionString']/following-sibling::string[1]"
        },
        {
          "type": "xml",
          "path": "phone/src-tauri/gen/apple/nocturne-phone_iOS/Info.plist",
          "xpath": "//dict/key[text()='CFBundleVersion']/following-sibling::string[1]"
        }
      ]
    }
  }
}
