{
  "$schema": "nocturne-tokens/1",
  "color": {
    "light": {
      "bg": "#EEEBE4",
      "sheet": "#FBFAF6",
      "raised": "#FFFFFF",
      "ink": "#17181C",
      "ink2": "#4A4B50",
      "ink3": "#66645E",
      "rule": "#DAD5CA",
      "rule2": "#17181C",
      "accent": "#2C4BCF",
      "onAccent": "#FFFFFF",
      "accentSoft": "#E3E7F8",
      "ember": "#A8402A",
      "emberSoft": "#F5E6DF",
      "marker": "#F2D488",
      "focus": "#2C4BCF"
    },
    "dark": {
      "bg": "#0E1014",
      "sheet": "#16191F",
      "raised": "#1E222A",
      "ink": "#ECE8DF",
      "ink2": "#ABA79E",
      "ink3": "#8A877F",
      "rule": "#2A2E37",
      "rule2": "#ECE8DF",
      "accent": "#9DB0FF",
      "onAccent": "#0E1014",
      "accentSoft": "#1E2640",
      "ember": "#EE8C6F",
      "emberSoft": "#3A2420",
      "marker": "#5C4A18",
      "focus": "#9DB0FF"
    },
    "print": { "ink": "#000000", "paper": "#FFFFFF", "rule": "#000000" },
    "contrastOnSheet": {
      "light": { "ink": 17.1, "ink2": 8.3, "ink3": 5.6, "accent": 6.6, "ember": 5.6 },
      "dark": { "ink": 14.6, "ink2": 7.6, "ink3": 4.9, "accent": 8.4, "ember": 7.2 }
    }
  },
  "font": {
    "serif": {
      "family": "Newsreader",
      "fallback": "Georgia, serif",
      "licence": "SIL OFL 1.1",
      "files": ["Newsreader[opsz,wght].woff2", "Newsreader-Italic[opsz,wght].woff2"]
    },
    "sans": {
      "family": "IBM Plex Sans",
      "fallback": "system-ui, sans-serif",
      "licence": "SIL OFL 1.1",
      "weights": [400, 500, 600]
    },
    "mono": {
      "family": "IBM Plex Mono",
      "fallback": "ui-monospace, monospace",
      "licence": "SIL OFL 1.1",
      "weights": [400, 500]
    }
  },
  "type": {
    "display": {
      "font": "serif",
      "size": "3.5rem",
      "lineHeight": 1.07,
      "weight": 400,
      "tracking": "-0.02em"
    },
    "pageTitle": {
      "font": "serif",
      "size": "2.5rem",
      "lineHeight": 1.1,
      "weight": 400,
      "tracking": "-0.015em"
    },
    "pageDek": {
      "font": "serif",
      "size": "1.25rem",
      "lineHeight": 1.5,
      "weight": 400,
      "style": "italic"
    },
    "pageLine": { "font": "serif", "size": "1.25rem", "lineHeight": 1.45, "weight": 400 },
    "answer": { "font": "serif", "size": "1.375rem", "lineHeight": 1.45, "weight": 400 },
    "uiTitle": { "font": "sans", "size": "1.25rem", "lineHeight": 1.4, "weight": 500 },
    "uiBody": { "font": "sans", "size": "0.9375rem", "lineHeight": 1.47, "weight": 400 },
    "uiLabel": { "font": "sans", "size": "0.8125rem", "lineHeight": 1.38, "weight": 500 },
    "section": {
      "font": "mono",
      "size": "0.75rem",
      "lineHeight": 1.33,
      "weight": 500,
      "tracking": "0.12em",
      "transform": "uppercase"
    },
    "receipt": { "font": "mono", "size": "0.75rem", "lineHeight": 1.33, "weight": 400 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64, "9": 96 },
  "radius": { "xs": 2, "sm": 4, "md": 8, "lg": 12, "full": 999 },
  "elevation": {
    "e0": "inset 0 0 0 1px var(--rule)",
    "e1": "0 1px 2px rgba(23,24,28,.06), 0 0 0 1px rgba(23,24,28,.06)",
    "e2": "0 18px 48px -12px rgba(23,24,28,.28), 0 0 0 1px rgba(23,24,28,.08)"
  },
  "motion": {
    "act": { "duration": 120, "easing": "cubic-bezier(0,0,.2,1)", "reduced": 0 },
    "settle": { "duration": 240, "easing": "cubic-bezier(.2,0,0,1)", "reduced": "fade 120" },
    "rest": { "duration": 700, "easing": "cubic-bezier(.4,0,.2,1)", "reduced": 0 },
    "breathe": { "duration": 2400, "loop": true, "opacity": [0.35, 1], "reduced": "static" },
    "fadeAway": { "duration": 400, "translateY": 4, "reduced": 0 }
  },
  "size": {
    "control": 40,
    "touch": 44,
    "rail": 232,
    "pageMeasure": 680,
    "quickCapture": [560, 168]
  },
  "breakpoints": { "narrow": 400, "standard": 960, "wide": 1440 },
  "icons": { "set": "Lucide", "licence": "ISC", "grid": 20, "stroke": 1.5 }
}
