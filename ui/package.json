{
  "name": "nocturne-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode mock",
    "dev:phone": "vite --config vite.phone.config.ts",
    "dev:tauri": "vite --mode tauri",
    "build": "tsc --noEmit && vite build --mode tauri && vite build --config vite.phone.config.ts",
    "build:phone": "vite build --config vite.phone.config.ts",
    "build:preview-real": "vite build --mode preview-real",
    "build:mock": "vite build --mode mock",
    "preview": "vite preview --mode mock --port 4174 --strictPort",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "biome check . && tsc --noEmit",
    "fmt": "biome format --write .",
    "tokens": "node scripts/build-tokens.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "^2.12.4",
    "intl-messageformat": "^12.1.5",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
