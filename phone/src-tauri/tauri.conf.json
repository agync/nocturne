{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nocturne",
  "version": "../../ui/package.json",
  "identifier": "app.nocturne.phone",
  "build": {
    "frontendDist": "../../ui/dist/phone-native"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "Nocturne", "backgroundColor": "#EEEBE4" }],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob:; media-src blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "android": { "minSdkVersion": 26 },
    "iOS": { "minimumSystemVersion": "17.0" }
  }
}
