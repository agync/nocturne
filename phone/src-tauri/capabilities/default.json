{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "What the phone screens may ask of the app.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "nocturne-system:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://nocturne.is/*" },
        { "url": "https://play.google.com/store/apps/details?id=is.nocturne.phone" }
      ]
    }
  ],
  "platforms": ["linux", "macOS", "windows", "android", "iOS"]
}
