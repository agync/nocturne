<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="keep"
        android:enabled="true"
        android:icon="@drawable/nocturne_shortcut_keep"
        android:shortcutShortLabel="@string/nocturne_shortcut_keep_short"
        android:shortcutLongLabel="@string/nocturne_shortcut_keep">
        <intent
